HF_TOKEN=your_huggingface_token_here
DEFAULT_BASE_BRANCH=dev
# Target repo override. Optional — defaults to the repo containing this
# checkout (the builder lives in devtools/adapter_builder inside
# TransformerLens). Set only to drive a different checkout.
# DEFAULT_TARGET_REPO=/path/to/TransformerLens
DEFAULT_MAX_MEMORY_GB=48
# Where agent pair worktrees are created. Optional — defaults to
# "<parent-of-TransformerLens>/worktrees" if unset.
# WORKTREE_BASE=/path/to/worktrees
NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
NOTIFICATION_NUMBER=+15551234567
